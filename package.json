{
  "name": "mkstudios-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express and MongoDB Atlas backend for MK Studios",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:all": "concurrently --kill-others --names api,web \"npm:dev\" \"npm:frontend:dev\"",
    "start": "node src/server.js",
    "test": "node --test",
    "seed:catalog": "node scripts/seedCatalog.js",
    "admin:hash": "node scripts/makeAdminHash.js",
    "frontend:dev": "vite --config vite.config.mjs",
    "frontend:build": "vite build --config vite.config.mjs",
    "frontend:preview": "vite preview --config vite.config.mjs",
    "smoke": "node --import ./scripts/smoke-register.mjs scripts/smokeInit.mjs"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.2",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "motion": "^14.10.1",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true
  }
}
